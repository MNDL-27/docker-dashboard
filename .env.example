[TEMPLATE]
# ── Frontend (VITE_ prefix required for client access) ──────
VITE_API_BASE_URL="/api"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
VITE_DONATION_URL="https://liberapay.com/MNDL-27/"
VITE_PAYPAL_DONATION_URL="https://www.paypal.com/paypalme/ProtikMondal27"

# ── Database ──────────────────────────────────────────────
# Neon Postgres pooled connection string
NETLIFY_DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# ── Secrets Encryption ────────────────────────────────────
# Backend master key for docker_host_secrets at rest. Not the same as AGENT_API_KEY.
APP_ENCRYPTION_ACTIVE_KEY_ID="V1"
APP_ENCRYPTION_KEY_V1="32-byte-base64-or-hex-key"
# APP_ENCRYPTION_KEY_V2="next-key-for-rotation"

# ── Authentication (Clerk) ────────────────────────────────
CLERK_SECRET_KEY="sk_test_..."
CLERK_AUTHORIZED_PARTIES="https://app.dockerdash.app,https://dockerdash.app,http://localhost:5173,http://localhost:8080,http://localhost:8888"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
CLERK_JWT_KEY="optional-custom-jwt-key..."
PLATFORM_ADMIN_EMAILS="admin@example.com"
REQUIRE_PLATFORM_APPROVALS="false"
# ENABLE_MOCK_AGENT enables the /api/mock-docker-agent fixture for local/preview use only.
# Automatically disabled when NODE_ENV=production.
ENABLE_MOCK_AGENT="true"

# ── Health Poller ─────────────────────────────────────────
# Shared secret that authorizes cron-based health checks.
HEALTH_POLL_SECRET="replace-with-random-string"
# Minutes after which a host is considered stale (default: 5)
# HOST_STALE_THRESHOLD_MINUTES=5

# ── Donor Billing (Liberapay + PayPal) ────────────────────
LIBERAPAY_WEBHOOK_SECRET="replace-with-long-random-string"
PAYPAL_WEBHOOK_SECRET="replace-with-long-random-string"
DONOR_REMINDER_CRON_SECRET="replace-with-long-random-string"

# ── Transactional Email (Resend) ──────────────────────────
EMAIL_PROVIDER="resend"
EMAIL_FROM="Dockerdash <no-reply@dockerdash.app>"
EMAIL_REPLY_TO="support@dockerdash.app"
RESEND_API_KEY="re_..."

# ── Optional / Legacy (not used by code, safe to remove) ──
# JWT_SECRET="replace-with-random-string"                # Vestigial — Clerk handles JWT
# NETLIFY_DATABASE_URL_UNPOOLED="..."                    # Auto-created by Neon integration
# VITE_CLERK_SIGN_IN_URL="..."                           # Hardcoded in App.tsx
# VITE_CLERK_SIGN_UP_URL="..."                           # Hardcoded in App.tsx
# VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="..."         # Hardcoded in App.tsx
# VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="..."         # Hardcoded in App.tsx
# VITE_CLERK_SIGN_IN_FORCE_REDIRECT_URL="..."            # Not used
# VITE_CLERK_SIGN_UP_FORCE_REDIRECT_URL="..."            # Not used
# VITE_PREVIEW_BYPASS_AUTH="false"                       # For Netlify deploy previews only
# APP_URL="https://app.dockerdash.app"                   # Used in slack/webhook delivery — often auto-set by Netlify
# URL="https://app.dockerdash.app"                       # Auto-set by Netlify
