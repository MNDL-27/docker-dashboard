# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL="/api"

# ── Database ──────────────────────────────────────────────
# Supabase -> Neon + Clerk Postgres Connection
DATABASE_URL="postgres://postgres:password@localhost:5432/postgres?sslmode=disable"

# Application Secrets
# Active secret-at-rest encryption key id.
APP_ENCRYPTION_ACTIVE_KEY_ID="V1"
# Key material for the active key id above. Must decode to exactly 32 bytes.
APP_ENCRYPTION_KEY_V1="YOUR_32_BYTE_BASE64_OR_HEX_ENCODED_STRING_HERE"
# Optional future rotation keys use the same pattern:
# APP_ENCRYPTION_KEY_V2="YOUR_NEXT_32_BYTE_BASE64_OR_HEX_KEY"

# ── Authentication ────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_AUTHORIZED_PARTIES="https://app.dockerdash.app,https://dockerdash.app,https://www.dockerdash.app,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8888"
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
CLERK_JWT_KEY="optional-custom-jwt-key..."
PLATFORM_ADMIN_EMAILS="admin@example.com"
ALLOW_LOCAL_AGENT_URLS="true"

# ── Health Poller ─────────────────────────────────────────
# ── Billing (Paddle) ──────────────────────────────────────
# Paddle Billing v2 configuration
VITE_PADDLE_CLIENT_TOKEN="token_..."
VITE_PADDLE_ENV="sandbox" # or "production"
PADDLE_WEBHOOK_SECRET="pdl_wh_..."
PADDLE_API_KEY="pdl_api_..."
PRO_PRICE_ID="pri_..."
TEAM_PRICE_ID="pri_..."
