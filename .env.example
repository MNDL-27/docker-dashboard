# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL="/api"

# ── Database ──────────────────────────────────────────────
# Supabase -> Neon + Clerk Postgres Connection
DATABASE_URL="postgres://postgres:password@localhost:5432/postgres?sslmode=disable"

# Application Secrets
# AES-256-GCM encryption key for securing docker_host_secrets at rest. 
# Must be exactly 32 bytes encoded in base64 or hex.
APP_ENCRYPTION_KEY_V1="YOUR_32_BYTE_BASE64_OR_HEX_ENCODED_STRING_HERE"

# ── Authentication ────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
CLERK_JWT_KEY="optional-custom-jwt-key..."

# ── Health Poller ─────────────────────────────────────────
# ── Billing (Paddle) ──────────────────────────────────────
# Paddle Billing v2 configuration
VITE_PADDLE_CLIENT_TOKEN="token_..."
VITE_PADDLE_ENV="sandbox" # or "production"
PADDLE_WEBHOOK_SECRET="pdl_wh_..."
PADDLE_API_KEY="pdl_api_..."
PRO_PRICE_ID="pri_..."
TEAM_PRICE_ID="pri_..."
